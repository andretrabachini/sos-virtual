# copie esse arquivo para .env e preencha os valores
# nao suba o .env pro github!

# banco MySQL com usuario proprio (nunca o root). formato:
# mysql+pymysql://usuario:senha@localhost/sos_virtual
DATABASE_URL=mysql+pymysql://sos_app:TROQUE_A_SENHA@localhost/sos_virtual

# obrigatorio, minimo 32 caracteres. gere com:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=

# validade do login em minutos
JWT_EXPIRES_MINUTES=60

# enderecos do front-end autorizados a chamar a API, separados por virgula
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# 1 so em desenvolvimento; deixe 0 em qualquer outro caso
FLASK_DEBUG=0
