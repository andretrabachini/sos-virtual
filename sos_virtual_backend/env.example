# copie esse arquivo para .env e preencha os valores
# nao suba o .env pro github!

# banco MySQL com usuario proprio (nunca o root). formato:
# mysql+pymysql://usuario:senha@localhost/sos_virtual
DATABASE_URL=mysql+pymysql://sos_app:TROQUE_A_SENHA@localhost/sos_virtual

# obrigatorio, minimo 32 caracteres. gere com:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=

# validade do login em minutos
JWT_EXPIRES_MINUTES=60

# enderecos do front-end autorizados a chamar a API, separados por virgula
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# 1 so em desenvolvimento; deixe 0 em qualquer outro caso
FLASK_DEBUG=0

# ---- recuperacao de senha ----
# endereco onde o front-end esta rodando (o link do e-mail aponta para ele)
FRONTEND_URL=http://127.0.0.1:5500/sos_virtual_frontend

# validade do link de redefinicao, em minutos
RESET_EXPIRES_MINUTES=30

# e-mail (SMTP). DEIXE EM BRANCO para testar na propria maquina: o e-mail aparece no terminal do servidor.
# exemplo com Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=seu@gmail.com e, em SMTP_PASSWORD,
# uma "senha de app" (Conta Google > Seguranca > Senhas de app); a senha normal nao funciona
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
